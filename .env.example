# =====================================================
# KornBeat - Variables de entorno para docker-compose
# Copiar a .env y ajustar valores (el .env está gitignored)
# =====================================================

# --- MongoDB ---
MONGO_USER=admin
MONGO_PASSWORD=change_me_mongo_password

# --- Neo4j ---
NEO4J_PASSWORD=change_me_neo4j_password

# --- Redis ---
REDIS_PASSWORD=change_me_redis_password

# --- MinIO ---
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_minio_password
MINIO_BUCKET=music-app

# --- JWT (auth-api + music-api) ---
JWT_SECRET=change_me_jwt_secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# --- CORS (orígenes permitidos, separados por coma) ---
CORS_ORIGINS=http://localhost,http://localhost:3000

# --- Sincronización (reco-api) ---
REDIS_CACHE_TTL=300
SYNC_INTERVAL_MINUTES=30
SYNC_HISTORY_DAYS=30
AUTO_SYNC_ON_START=true
